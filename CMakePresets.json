{
    "version": 3,
    "configurePresets": [
        {
            "name": "pixi-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}"
            }
        },
        {
            "name": "pixi-debug",
            "displayName": "Pixi Debug (RelWithDebInfo)",
            "description": "Uses RelWithDebInfo, not Debug: conda-forge's Windows C++ packages are Release-only (/MD); mixing them with a /MDd (Debug) build corrupts memory across the DLL boundary. See CLAUDE.md.",
            "inherits": "pixi-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BUILD_MATLAB_BINDINGS": "OFF"
            }
        },
        {
            "name": "pixi-release",
            "displayName": "Pixi Release",
            "inherits": "pixi-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_MATLAB_BINDINGS": "OFF"
            }
        },
        {
            "name": "pixi-debug-matlab",
            "displayName": "Pixi Debug (RelWithDebInfo) + MATLAB bindings",
            "description": "Same as pixi-debug plus BUILD_MATLAB_BINDINGS=ON, and deliberately sharing pixi-debug's build tree so switching between the two does not recompile the core toolbox. Both presets pin BUILD_MATLAB_BINDINGS explicitly, so switching flips it rather than inheriting whichever value the shared cache happened to hold. Requires MATLAB: find_package(Matlab) is REQUIRED, so configuring fails without it, which is why this is opt-in rather than the default.",
            "inherits": "pixi-debug",
            "binaryDir": "${sourceDir}/out/build/pixi-debug",
            "cacheVariables": {
                "BUILD_MATLAB_BINDINGS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "pixi-debug",
            "configurePreset": "pixi-debug"
        },
        {
            "name": "pixi-release",
            "configurePreset": "pixi-release"
        },
        {
            "name": "pixi-debug-matlab",
            "configurePreset": "pixi-debug-matlab"
        }
    ],
    "testPresets": [
        {
            "name": "pixi-debug",
            "configurePreset": "pixi-debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "pixi-release",
            "configurePreset": "pixi-release",
            "output": { "outputOnFailure": true }
        }
    ]
}
