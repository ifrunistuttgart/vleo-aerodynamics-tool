							"parentStyle": false,
							"left": 112,
							"top": 1024,
							"width": 208,
							"height": 38,
							"text": "wie pacakges in staruml machen?"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGcGugKYv9noc8=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
