							},
							"fillColor": "#A3FFA3",
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 8,
							"top": 1328,
							"width": 248,
							"height": 88,
							"text": "hat der satellit einen shader oder der shader einen satellit?\neher shader hat satellite, da shader volatiler ist, evtl zusammengefasst werden soll mit force calculation"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGcItdO4Ipp0Ow=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"fillColor": "#A3FFA3",
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 8,
							"top": 1424,
							"width": 456,
							"height": 79,
							"text": "wenn sowohl shader als auch calculator einen Satellite haben, wie kann muss ich sicherstelen, dass beide den gleichen haben, ist das flasch?\nPerse nicht falsch, aber es sollte beachteet, werden, dasss dadruch nicht unterschwellig ein SOLID principle verletzt wird. Außerdem sollte zur übernahme des \"wiring\" ein fcatory benutzt werden"
						},
