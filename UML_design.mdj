							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 32,
							"top": 280,
							"width": 100,
							"height": 157,
							"text": "wie sollte UI von satelliten etc getrennt sein?\naufteilungs in presenter und view, das ist voerst aber wahrsceinlich overkill"
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGcGugKkP+4FEM=",
							"_parent": {
